{
	"name": "brain-view-pro",
	"version": "1.0.0",
	"description": "3D Brain knowledge graph with study workbench: note preview, personal annotations, node color markers, and hierarchical globular clustering for Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"3d-graph",
		"brain",
		"knowledge-graph",
		"study",
		"flashcards",
		"exam",
		"threejs"
	],
	"author": "P123149P",
	"license": "MIT",
	"dependencies": {
		"3d-force-graph": "1.80.0",
		"d3-force-3d": "3.0.6",
		"three": "0.184.0",
		"three-spritetext": "1.10.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/three": "^0.184.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.0.0"
	}
}
